# Optional model overrides (defaults shown).
# Pro for the writing-heavy essay stage, Flash for the analytical stages.
SCHOLAR_ESSAY_MODEL=gemini-2.5-pro
SCHOLAR_DEFAULT_MODEL=gemini-2.5-flash
